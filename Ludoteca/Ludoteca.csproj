<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Ludoteca.ico</ApplicationIcon>
    <AssemblyName>JOGOTECA</AssemblyName>
    <RootNamespace>Ludoteca</RootNamespace>
    <Version>2.1.0</Version>
    <StartupObject>Ludoteca.Program</StartupObject>
    <Authors>JOGOTECA</Authors>
    <Product>JOGOTECA - Backlog pessoal de jogos</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Ludoteca.png" />
    <Resource Include="Assets\LudotecaMark.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
