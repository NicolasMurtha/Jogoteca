                            <TextBlock Text="Consultando as fontes..."
                                       Margin="0,13,0,0"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ManualGameOverlay"
              Grid.RowSpan="2"
              Background="#7629282D"
              Visibility="Collapsed"
              Panel.ZIndex="25">
            <Border Width="610"
                    Padding="28"
                    Background="{StaticResource AppBackground}"
                    CornerRadius="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
