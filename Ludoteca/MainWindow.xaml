                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding CategoryDisplay}"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Border Margin="0,0,8,8"
                                                Padding="10,7"
                                                Background="{DynamicResource SurfaceMuted}"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="PÚBLICO"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="{Binding PublicRatingDisplay}"
                                                           Margin="0,2,0,0"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,8,8"
                                                Padding="10,7"
                                                Background="{DynamicResource SurfaceMuted}"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="TEMPO PARA ZERAR"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="{Binding CompletionTimeDisplay}"
                                                           Margin="0,2,0,0"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}"
