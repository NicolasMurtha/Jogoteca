                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Slider x:Name="RatingSlider"
                                                Width="210"
                                                Minimum="-1"
                                                Maximum="10"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
