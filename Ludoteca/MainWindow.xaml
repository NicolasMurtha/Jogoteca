                                    Margin="0,17,0,0"
                                    HorizontalAlignment="Center"
                                    Click="OpenManualGame_Click"
                                    Content="Cadastrar manualmente" />
                        </StackPanel>

                        <StackPanel x:Name="SearchLoadingState"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
