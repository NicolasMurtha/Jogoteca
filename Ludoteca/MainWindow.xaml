        <Grid x:Name="ListEditorOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource OverlayScrim}"
              Visibility="Collapsed"
              Panel.ZIndex="50">
            <Border Width="470"
                    Padding="27"
                    Background="{DynamicResource AppBackground}"
                    CornerRadius="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ListEditorTitle"
                               Text="Criar uma lista"
                               FontSize="23"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ListEditorSubtitle"
                               Text="Personalize o nome, o emoji e a cor da lista."
                               Margin="0,6,0,18"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Emoji" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold" />
                            <ComboBox x:Name="ListEmojiComboBox"
                                      ItemsSource="{Binding ListEmojiOptions}"
                                      SelectedValue="{Binding SelectedListEmoji, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Emoji"
                                      Height="42"
                                      Width="86"
                                      HorizontalAlignment="Left"
                                      Padding="8,4"
                                      Background="{DynamicResource Surface}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      Foreground="{DynamicResource TextPrimary}">
                                <ComboBox.Resources>
                                    <Style TargetType="{x:Type ComboBoxItem}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        <Setter Property="Background" Value="{DynamicResource Surface}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="3" />
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Width="168" />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Emoji}"
                                                   Style="{StaticResource EmojiText}"
                                                   FontSize="19"
                                                   Width="34"
                                                   Height="30"
                                                   LineHeight="28"
                                                   ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Nome" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold" />
                            <TextBox x:Name="NewListNameBox"
                                     Style="{StaticResource TextInput}"
                                     MaxLength="40"
                                     KeyDown="NewListNameBox_KeyDown" />
