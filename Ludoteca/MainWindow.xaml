                        <Button x:Name="ListColorMintButton" Style="{StaticResource ColorSwatchButton}" Tag="#B9DDCF" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#B9DDCF" />
                        </Button>
                        <Button x:Name="ListColorPeachButton" Style="{StaticResource ColorSwatchButton}" Tag="#F5C6B5" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#F5C6B5" />
