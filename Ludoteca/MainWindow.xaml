<Window x:Class="Ludoteca.MainWindow"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="JOGOTECA"
        Width="1380"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmojiText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <DataTemplate x:Key="DiscoveryGameCardTemplate">
            <Button Style="{StaticResource CardButton}"
                    Width="168"
                    Height="270"
                    Margin="0,0,12,5"
                    Click="CatalogCard_Click">
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="200" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource CoverPlaceholderBackground}"
                                CornerRadius="13,13,0,0"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE7FC;"
                                           FontSize="34"
                                           Foreground="{DynamicResource CoverPlaceholderIcon}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Border CornerRadius="13,13,0,0">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CoverDisplay, Converter={StaticResource CoverImage}, ConverterParameter=168x200}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="11,9">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding YearDisplay}"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            Margin="15,0"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/LudotecaMark.png"
                           Width="24"
                           Height="24"
                           Stretch="UniformToFill" />
                    <TextBlock Text="JOGOTECA"
                               Margin="9,0,0,0"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <Border Margin="9,0,0,0"
                            Padding="7,2"
                            Background="{DynamicResource VersionBadgeBackground}"
                            CornerRadius="8">
                        <TextBlock Text="{Binding AppVersionDisplay}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource VersionBadgeForeground}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="SupportButton"
                            Height="28"
                            Margin="0,0,6,0"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="OpenSupport_Click"
                            ToolTip="Apoie a JOGOTECA"
                            AutomationProperties.Name="Apoiar a JOGOTECA"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border"
                                        Background="{DynamicResource NavSelectedBackground}"
                                        CornerRadius="14"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource NavCounterBackground}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Border" Property="Opacity" Value="0.8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💜"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Apoiar"
                                       Margin="6,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="ToggleTheme_Click"
                            ToolTip="{Binding ThemeToggleText}"
                            AutomationProperties.Name="{Binding ThemeToggleText}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="{Binding ThemeToggleIcon}"
                                   FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="ToggleNotifications_Click"
                            ToolTip="Notificações"
                            AutomationProperties.Name="Notificações"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="22"
                              Height="22">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE7ED;"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#F05B5B"
                                     Stroke="{DynamicResource TitleBarBackground}"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="&#xE921;"
                                   FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="MaximizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeIcon"
                                   FontFamily="Segoe Fluent Icons"
                                   Text="&#xE922;"
                                   FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="&#xE8BB;"
                                   FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="15,18,15,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="6,2,6,18">
                        <TextBlock Text="MEU BACKLOG"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="Descubra, guarde e organize"
                                   Margin="0,7,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="os jogos do seu jeito."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="DiscoverButton"
                                Style="{StaticResource NavButton}"
                                Background="{DynamicResource NavSelectedBackground}"
                                Click="DiscoverButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE8B1;"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Descobrir"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="AllGamesButton"
                                Style="{StaticResource NavButton}"
                                Margin="0,3,0,0"
                                AutomationProperties.Name="Biblioteca"
                                Click="AllGamesButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE8F1;"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Biblioteca"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Background="{DynamicResource NavCounterBackground}"
                                        Padding="7,2"
                                        CornerRadius="9">
                                    <TextBlock Text="{Binding Library.TotalGameCount}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,22,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="7,0,5,9">
                            <TextBlock Text="LISTAS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="OpenCreateListButton"
                                    Style="{StaticResource IconButton}"
                                    Width="27"
                                    Height="27"
                                    HorizontalAlignment="Right"
                                    Click="OpenCreateList_Click"
                                    ToolTip="Criar lista">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE710;"
                                           FontSize="12" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Library.Lists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavButton}"
                                                Margin="0,2"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="ListButton_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="ListButton_PreviewMouseMove"
                                                Click="ListButton_Click"
                                                DragEnter="ListButton_DragEnter"
                                                DragLeave="ListButton_DragLeave"
                                                Drop="ListButton_Drop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="31" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="24"
                                                      HorizontalAlignment="Left">
                                                    <Ellipse Width="17"
                                                             Height="17"
                                                             Fill="{Binding Color}" />
                                                    <TextBlock Text="{Binding Emoji}"
                                                               Style="{StaticResource EmojiText}"
                                                               FontSize="12"
                                                               Width="20"
                                                               Height="20"
                                                               LineHeight="18"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CountDisplay}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Button Grid.Row="3"
                            Style="{StaticResource NavButton}"
                            Click="OpenSettings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE713;"
                                       FontSize="16" />
                            <TextBlock Grid.Column="1"
                                       Text="Configurações"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="DiscoveryPanel">
                    <ScrollViewer x:Name="DiscoveryScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="34,28,28,36">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Descobrir"
                                               FontSize="30"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Um catálogo para encontrar o próximo jogo da sua biblioteca."
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="13" />
                                </StackPanel>
                                <Button Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="SearchOnline_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   Text="&#xE721;"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="Buscar jogo" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border x:Name="DiscoveryUnavailableState"
                                    Margin="0,26,6,0"
                                    Padding="28"
                                    Background="{DynamicResource WarningBackground}"
                                    BorderBrush="{DynamicResource WarningBorder}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Visibility="{Binding Discover.IsUnavailable, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <StackPanel Margin="0,0,190,0">
                                        <TextBlock x:Name="DiscoveryUnavailableTitle"
                                                   Text="{Binding Discover.UnavailableTitle}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="DiscoveryUnavailableMessage"
                                                   Text="{Binding Discover.UnavailableMessage}"
                                                   Margin="0,7,0,0"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="OpenSettings_Click"
                                            Content="Configurar APIs" />
                                </Grid>
                            </Border>

                            <StackPanel x:Name="DiscoveryContent"
                                        Visibility="{Binding Discover.IsContentVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="0,22,6,0"
                                           HorizontalAlignment="Right"
                                           Text="As faixas carregam mais jogos perto do fim e usam cache por 12 horas"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" />

                                <ItemsControl ItemsSource="{Binding Discover.Sections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,24,0,0"
                                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Margin="0,0,6,11">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="20"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Margin="0,4,0,0"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="12" />
                                                </StackPanel>

                                                <Grid Margin="0,0,6,0">
                                                    <ScrollViewer x:Name="SectionScrollViewer"
                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                  VerticalScrollBarVisibility="Disabled"
                                                                  PanningMode="HorizontalOnly"
                                                                  PreviewMouseWheel="CatalogSectionScrollViewer_PreviewMouseWheel"
                                                                  ScrollChanged="CatalogSectionScrollViewer_ScrollChanged">
                                                        <ItemsControl ItemsSource="{Binding Games}"
                                                                      ItemTemplate="{StaticResource DiscoveryGameCardTemplate}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </ScrollViewer>

                                                    <Border Padding="10,6"
                                                            Margin="0,0,50,8"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Background="{DynamicResource LoadingPillBackground}"
                                                            CornerRadius="10"
                                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                                            Panel.ZIndex="3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="•••"
                                                                       Margin="0,-3,7,0"
                                                                       Foreground="{DynamicResource AccentForeground}"
                                                                       FontWeight="Bold" />
                                                            <TextBlock Text="Carregando mais"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondary}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Button Style="{StaticResource IconButton}"
                                                            Width="38"
                                                            Height="76"
                                                            Margin="4,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource FloatingButtonBackground}"
                                                            Tag="{Binding ElementName=SectionScrollViewer}"
                                                            Click="ScrollCatalogSectionLeft_Click"
                                                            Panel.ZIndex="2">
                                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                                   Text="&#xE76B;"
                                                                   FontSize="17" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}"
                                                            Width="38"
                                                            Height="76"
                                                            Margin="0,0,4,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource FloatingButtonBackground}"
                                                            Tag="{Binding ElementName=SectionScrollViewer}"
                                                            Click="ScrollCatalogSectionRight_Click"
                                                            Panel.ZIndex="2">
                                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                                   Text="&#xE76C;"
                                                                   FontSize="17" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel x:Name="DiscoveryLoadingState"
                                            Margin="0,34,0,24"
                                            Visibility="{Binding Discover.IsLoading, Converter={StaticResource BoolToVisibility}}">
                                    <ProgressBar Width="190"
                                                 Height="5"
                                                 IsIndeterminate="True" />
                                    <TextBlock Text="Carregando jogos..."
                                               Margin="0,10,0,0"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>

                                <TextBlock x:Name="CatalogAttributionText"
                                           Text="{Binding Discover.AttributionText}"
                                           Margin="0,14,6,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11"
                                           Cursor="Hand"
                                           TextDecorations="Underline"
                                           MouseLeftButtonDown="CatalogAttributionText_MouseLeftButtonDown" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="LibraryPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="34,28,34,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Library.Title}"
                                           FontSize="29"
                                           FontWeight="SemiBold" />
                                <Button x:Name="EditCurrentListButton"
                                        Style="{StaticResource IconButton}"
                                        Margin="8,0,0,0"
                                        Width="32"
                                        Height="32"
                                        Visibility="{Binding Library.IsViewingList, Converter={StaticResource BoolToVisibility}}"
                                        Click="EditCurrentList_Click"
                                        ToolTip="Editar esta lista">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE70F;"
                                               FontSize="14" />
                                </Button>
                                <Button x:Name="DeleteCurrentListButton"
                                        Style="{StaticResource IconButton}"
                                        Margin="2,0,0,0"
                                        Width="32"
                                        Height="32"
                                        Visibility="{Binding Library.IsViewingList, Converter={StaticResource BoolToVisibility}}"
                                        Click="DeleteCurrentList_Click"
                                        ToolTip="Excluir esta lista">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE74D;"
                                               FontSize="14"
                                               Foreground="{DynamicResource DangerForeground}" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding Library.Subtitle}"
                                       Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="13" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Margin="0,0,12,0"
                                    Padding="3"
                                    Background="{DynamicResource SurfaceMuted}"
                                    CornerRadius="11">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="LibraryGridViewButton"
                                            Style="{StaticResource IconButton}"
                                            Width="36"
                                            Height="36"
                                            Background="{DynamicResource Surface}"
                                            Click="ShowLibraryGridView_Click"
                                            AutomationProperties.Name="Visualização em cards"
                                            ToolTip="Visualização em cards">
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   Text="&#xF0E2;"
                                                   FontSize="15" />
                                    </Button>
                                    <Button x:Name="LibraryListViewButton"
                                            Style="{StaticResource IconButton}"
                                            Width="36"
                                            Height="36"
                                            Click="ShowLibraryListView_Click"
                                            AutomationProperties.Name="Visualização em lista"
                                            ToolTip="Visualização em lista">
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   Text="&#xEA37;"
                                                   FontSize="15" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Grid Width="190" Height="43" Margin="0,0,7,0">
                                <TextBox x:Name="LibraryNameFilterBox"
                                         Style="{StaticResource TextInput}"
                                         TextChanged="LibraryNameFilterBox_TextChanged"
                                         KeyDown="LibraryNameFilterBox_KeyDown" />
                                <TextBlock x:Name="LibraryNameFilterPlaceholder"
                                           Text="Pesquisar na biblioteca"
                                           Margin="14,0"
                                           Foreground="{DynamicResource SearchPlaceholderText}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Width="38"
                                    Height="43"
                                    Margin="0,0,7,0"
                                    Padding="0"
                                    Click="ApplyLibraryNameFilter_Click"
                                    ToolTip="Pesquisar na biblioteca/lista">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE721;"
                                           FontSize="14" />
                            </Button>
                            <Button x:Name="LibraryAddFirstButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,0,0"
                                    Padding="16,10"
                                    Click="SearchOnline_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE710;"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Adicionar jogo" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="34,0,34,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource StatLibraryBackground}" CornerRadius="16" Padding="18,15" Margin="0,0,10,0">
                            <Grid>
                                <StackPanel Margin="0,0,44,0">
                                    <TextBlock Text="SEM NOTA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatLibraryForeground}" />
                                    <TextBlock Text="{Binding Library.UnratedGameCount}" Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}"
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource LoadingPillBackground}"
                                        Click="ShowUnratedGames_Click"
                                        ToolTip="Ver jogos sem nota">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE8A7;"
                                               FontSize="13" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource StatRatingBackground}" CornerRadius="16" Padding="18,15" Margin="5,0">
                            <Grid>
                                <StackPanel Margin="0,0,44,0">
                                    <TextBlock Text="REVIEWS ESCRITAS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatRatingForeground}" />
                                    <TextBlock Text="{Binding Library.ReviewedGameCount}" Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}"
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource LoadingPillBackground}"
                                        Click="ShowReviewedGames_Click"
                                        ToolTip="Ver jogos com review">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE8A7;"
                                               FontSize="13" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource StatReviewBackground}" CornerRadius="16" Padding="18,15" Margin="10,0,0,0">
                            <Grid>
                                <StackPanel Margin="0,0,44,0">
                                    <TextBlock Text="NÃO ORGANIZADOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatReviewForeground}" />
                                    <TextBlock Text="{Binding Library.UnorganizedGameCount}" Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}"
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource LoadingPillBackground}"
                                        Click="ShowUnorganizedGames_Click"
                                        ToolTip="Ver jogos sem lista">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE8A7;"
                                               FontSize="13" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ItemsControl x:Name="LibraryGridView"
                                      ItemsSource="{Binding Library.Games}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Standard"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                  Focusable="False"
                                                  Padding="28,0,20,28">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <vwp:VirtualizingWrapPanel SpacingMode="None" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="GameCardHoverArea"
                                          Width="204"
                                          Height="322"
                                          Background="Transparent"
                                          Margin="6,0,0,0">
                                        <Button Style="{StaticResource CardButton}"
                                                Width="184"
                                                Height="304"
                                                Margin="0,0,14,18"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Click="GameCard_Click"
                                                PreviewMouseLeftButtonDown="GameCard_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="GameCard_PreviewMouseMove">
                                            <Border Background="{DynamicResource Surface}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="224" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{DynamicResource CoverPlaceholderBackground}"
                                                            CornerRadius="13,13,0,0"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock FontFamily="Segoe Fluent Icons"
                                                                       Text="&#xE7FC;"
                                                                       FontSize="35"
                                                                       Foreground="{DynamicResource CoverPlaceholderIcon}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Border CornerRadius="13,13,0,0">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding CoverDisplay, Converter={StaticResource CoverImage}, ConverterParameter=184x224}"
                                                                                Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,10,9,0"
                                                            Padding="8,4"
                                                            Background="{DynamicResource RatingOverlayBackground}"
                                                            CornerRadius="10">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="Segoe Fluent Icons"
                                                                       Text="&#xE735;"
                                                                       Foreground="{DynamicResource StarBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,0,4,0" />
                                                            <TextBlock Text="{Binding RatingDisplay}"
                                                                       Foreground="{DynamicResource RatingOverlayForeground}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Grid.Row="1" Margin="13,10">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding YearDisplay}"
                                                                   Margin="0,5,0,0"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding PublicRatingDisplay, StringFormat=Público: {0}}"
                                                                   Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource AccentForeground}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CategoryDisplay}"
                                                                   Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>

                                        <StackPanel x:Name="GameCardActions"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,8,0,0"
                                                    Opacity="0"
                                                    IsHitTestVisible="False">
                                            <Button Style="{StaticResource IconButton}"
                                                    Width="32"
                                                    Height="32"
                                                    Margin="0,0,0,6"
                                                    Background="{DynamicResource ActionNeutralBackground}"
                                                    ToolTip="Retirar desta lista"
                                                    Visibility="{Binding DataContext.Library.IsViewingList, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                                    Click="RemoveGameFromCurrentList_Click">
                                                <TextBlock Text="−"
                                                           FontSize="19"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource ActionNeutralForeground}" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Width="32"
                                                    Height="32"
                                                    Background="{DynamicResource ActionDangerBackground}"
                                                    ToolTip="Remover da biblioteca"
                                                    Visibility="{Binding DataContext.Library.IsViewingLibrary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                                    Click="DeleteGameFromCard_Click">
                                                <TextBlock Text="×"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource ActionDangerForeground}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="GameCardHoverArea"
                                                 Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="GameCardActions"
                                                    Property="Opacity"
                                                    Value="1" />
                                            <Setter TargetName="GameCardActions"
                                                    Property="IsHitTestVisible"
                                                    Value="True" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid x:Name="LibraryListView"
                              Margin="34,0,28,0"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                Margin="0,0,0,8"
                                    Padding="0"
                                    Background="{DynamicResource SurfaceMuted}"
                                    CornerRadius="11">
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource CardButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,18,0"
                                            Click="SortByNameHeader_Click"
                                            ToolTip="Ordenar por nome">
                                        <TextBlock Text="{Binding DataContext.Library.NameSortHeaderText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource CardButton}"
                                            HorizontalAlignment="Left"
                                            Click="SortByReleaseHeader_Click"
                                            ToolTip="Ordenar por lançamento">
                                        <TextBlock Text="{Binding DataContext.Library.ReleaseSortHeaderText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </Button>
                                    <TextBlock Grid.Column="3"
                                               Text="Notas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="4"
                                               Text="Observação"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,18,0" />
                                </Grid>
                            </Border>

                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding Library.Games}"
                                          HorizontalContentAlignment="Stretch"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Standard"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                      Focusable="False"
                                                      Padding="0,0,0,28">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Style="{StaticResource CardButton}"
                                                        Height="92"
                                                        Click="GameCard_Click"
                                                        PreviewMouseLeftButtonDown="GameCard_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="GameCard_PreviewMouseMove">
                                                    <Grid Margin="12,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="62" />
                                                            <ColumnDefinition Width="240" />
                                                            <ColumnDefinition Width="135" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="52"
                                                                Height="72"
                                                                HorizontalAlignment="Left"
                                                                Background="{DynamicResource CoverPlaceholderBackground}"
                                                                CornerRadius="8"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock FontFamily="Segoe Fluent Icons"
                                                                           Text="&#xE7FC;"
                                                                           FontSize="22"
                                                                           Foreground="{DynamicResource CoverPlaceholderIcon}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                <Border CornerRadius="8">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="{Binding CoverDisplay, Converter={StaticResource CoverImage}, ConverterParameter=52x72}"
                                                                                    Stretch="UniformToFill" />
                                                                    </Border.Background>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Column="1"
                                                                    Margin="0,0,18,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,5,0,0"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       FontSize="11"
                                                                       Text="{Binding CategoryDisplay}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding ReleaseDateDisplay}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <StackPanel Grid.Column="3"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontFamily="Segoe Fluent Icons"
                                                                           Text="&#xE735;"
                                                                           Foreground="{DynamicResource StarMutedBrush}"
                                                                           FontSize="13"
                                                                           Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding RatingDisplay}"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding PublicRatingDisplay, StringFormat=Público: {0}}"
                                                                       Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       FontSize="10"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="4"
                                                                   Margin="0,0,18,0"
                                                                   Text="{Binding ReviewDisplay}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}"
                                                            Width="32"
                                                            Height="32"
                                                            Margin="0,0,5,0"
                                                            Background="{DynamicResource ActionNeutralBackground}"
                                                            ToolTip="Retirar desta lista"
                                                            Visibility="{Binding DataContext.Library.IsViewingList, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                                            Click="RemoveGameFromCurrentList_Click">
                                                        <TextBlock Text="−"
                                                                   FontSize="19"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource ActionNeutralForeground}" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}"
                                                            Width="32"
                                                            Height="32"
                                                            Background="{DynamicResource ActionDangerBackground}"
                                                            ToolTip="Remover da biblioteca"
                                                            Visibility="{Binding DataContext.Library.IsViewingLibrary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                                            Click="DeleteGameFromCard_Click">
                                                        <TextBlock Text="×"
                                                                   FontSize="20"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource ActionDangerForeground}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <StackPanel x:Name="EmptyLibraryState"
                                    Width="430"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Library.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <Border Width="76"
                                    Height="76"
                                    Background="{DynamicResource EmptyIconBackground}"
                                    CornerRadius="22"
                                    HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE8F1;"
                                           FontSize="30"
                                           Foreground="{DynamicResource EmptyIconForeground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyLibraryTitle"
                                       Text="{Binding Library.EmptyTitle}"
                                       Margin="0,19,0,0"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="EmptyLibraryMessage"
                                       Text="{Binding Library.EmptyMessage}"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       LineHeight="20" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Center"
                                    Click="FocusSearch_Click"
                                    Content="Adicionar primeiro jogo" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="SearchOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource OverlayScrim}"
              Visibility="Collapsed"
              Panel.ZIndex="20">
            <Border Width="760"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource AppBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid Margin="28,25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Encontrar um jogo"
                                       FontSize="26"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ProviderDescriptionText"
                                       Text="Busque online ou cadastre as informações manualmente."
                                       Margin="0,5,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="CloseSearchOverlay_Click">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE8BB;"
                                       FontSize="14" />
                        </Button>
                        <Button x:Name="OpenManualGameButton"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,48,0"
                                Padding="13,8"
                                Click="OpenManualGame_Click"
                                Content="Adicionar manualmente" />
                    </Grid>

                    <Grid x:Name="OnlineSearchPanel"
                          Grid.Row="1"
                          Margin="0,22,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Height="44">
                            <TextBox x:Name="OverlaySearchBox"
                                     Style="{StaticResource TextInput}"
                                     TextChanged="OverlaySearchBox_TextChanged"
                                     KeyDown="OverlaySearchBox_KeyDown" />
                            <TextBlock x:Name="OverlaySearchPlaceholder"
                                       Text="Nome do jogo..."
                                       Margin="14,0"
                                       Foreground="{DynamicResource SearchPlaceholderText}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0"
                                Padding="16,10"
                                Click="OverlaySearchButton_Click"
                                Content="Buscar" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Search.Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,5,12"
                                                Padding="12"
                                                Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="78"
                                                        Height="105"
                                                        Background="{DynamicResource CoverPlaceholderBackground}"
                                                        CornerRadius="10"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                                   Text="&#xE7FC;"
                                                                   Foreground="{DynamicResource CoverPlaceholderIcon}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Border CornerRadius="10">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding CoverDisplay, Converter={StaticResource CoverImage}, ConverterParameter=78x105}"
                                                                            Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="7,1,16,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="15"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SourceDisplay}"
                                                               Margin="0,5,0,0"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentForeground}" />
                                                    <TextBlock Text="{Binding DescriptionDisplay}"
                                                               Margin="0,8,0,0"
                                                               MaxHeight="43"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="13,8"
                                                        VerticalAlignment="Center"
                                                        Click="AddSearchResult_Click"
                                                        Content="Adicionar" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="SearchEmptyState"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Search.IsEmptyStateVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE721;"
                                       FontSize="31"
                                       Foreground="{DynamicResource EmptyGlyphForeground}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="SearchEmptyTitle"
                                       Text="{Binding Search.EmptyTitle}"
                                       Margin="0,13,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="SearchEmptyMessage"
                                       Text="{Binding Search.EmptyMessage}"
