                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="1." FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Clique em Abrir o RAWG abaixo e depois em Get API Key." TextWrapping="Wrap" LineHeight="20" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="2." FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Crie uma conta gratuita ou entre com a sua." TextWrapping="Wrap" LineHeight="20" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="3." FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Preencha o formulário curto. Em nome do app, coloque JOGOTECA; em site, pode usar github.com/NicolasMurtha/Jogoteca." TextWrapping="Wrap" LineHeight="20" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="4." FontWeight="SemiBold" />
