<Window x:Class="Ludoteca.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="JOGOTECA"
        Width="1380"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,9,0" />
        </Style>

        <Style x:Key="EmojiText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <DataTemplate x:Key="DiscoveryGameCardTemplate">
            <Button Style="{StaticResource CardButton}"
                    Width="168"
                    Height="270"
                    Margin="0,0,12,5"
                    Click="CatalogCard_Click">
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="200" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource CoverPlaceholderBackground}"
                                CornerRadius="13,13,0,0"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE7FC;"
                                           FontSize="34"
                                           Foreground="{DynamicResource CoverPlaceholderIcon}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Border CornerRadius="13,13,0,0">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CoverDisplay}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="11,9">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding YearDisplay}"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            Margin="15,0"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/LudotecaMark.png"
                           Width="24"
                           Height="24"
                           Stretch="UniformToFill" />
                    <TextBlock Text="JOGOTECA"
                               Margin="9,0,0,0"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <Border Margin="9,0,0,0"
                            Padding="7,2"
                            Background="{DynamicResource VersionBadgeBackground}"
                            CornerRadius="8">
                        <TextBlock Text="1.2.2"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource VersionBadgeForeground}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="ToggleTheme_Click"
                            ToolTip="{Binding ThemeToggleText}"
                            AutomationProperties.Name="{Binding ThemeToggleText}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="{Binding ThemeToggleIcon}"
                                   FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="&#xE921;"
                                   FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="MaximizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeIcon"
                                   FontFamily="Segoe Fluent Icons"
                                   Text="&#xE922;"
                                   FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="&#xE8BB;"
                                   FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="15,18,15,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="6,2,6,18">
                        <TextBlock Text="MEU BACKLOG"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="Descubra, guarde e organize"
                                   Margin="0,7,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="os jogos do seu jeito."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="DiscoverButton"
                                Style="{StaticResource NavButton}"
                                Background="{DynamicResource NavSelectedBackground}"
                                Click="DiscoverButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE8B1;"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Descobrir"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="AllGamesButton"
                                Style="{StaticResource NavButton}"
                                Margin="0,3,0,0"
                                AutomationProperties.Name="Biblioteca"
                                Click="AllGamesButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE8F1;"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Biblioteca"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Background="{DynamicResource NavCounterBackground}"
                                        Padding="7,2"
                                        CornerRadius="9">
                                    <TextBlock Text="{Binding TotalGameCount}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,22,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="7,0,5,9">
                            <TextBlock Text="LISTAS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="OpenCreateListButton"
                                    Style="{StaticResource IconButton}"
                                    Width="27"
                                    Height="27"
                                    HorizontalAlignment="Right"
                                    Click="OpenCreateList_Click"
                                    ToolTip="Criar lista">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE710;"
                                           FontSize="12" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Lists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavButton}"
                                                Margin="0,2"
                                                AllowDrop="True"
                                                Click="ListButton_Click"
                                                DragEnter="ListButton_DragEnter"
                                                DragLeave="ListButton_DragLeave"
                                                Drop="ListButton_Drop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="20"
                                                      HorizontalAlignment="Left">
                                                    <Ellipse Width="14"
                                                             Height="14"
                                                             Fill="{Binding Color}" />
                                                    <TextBlock Text="{Binding Emoji}"
                                                               Style="{StaticResource EmojiText}"
                                                               FontSize="11"
                                                               Width="18"
                                                               Height="18"
                                                               LineHeight="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CountDisplay}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Button Grid.Row="3"
                            Style="{StaticResource NavButton}"
                            Click="OpenSettings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE713;"
                                       FontSize="16" />
                            <TextBlock Grid.Column="1"
                                       Text="Configurações"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="DiscoveryPanel">
                    <ScrollViewer x:Name="DiscoveryScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="34,28,28,36">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Descobrir"
                                               FontSize="30"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Um catálogo para encontrar o próximo jogo da sua biblioteca."
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="13" />
                                </StackPanel>
                                <Button Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="SearchOnline_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   Text="&#xE721;"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="Buscar jogo" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border x:Name="DiscoveryUnavailableState"
                                    Margin="0,26,6,0"
                                    Padding="28"
                                    Background="{DynamicResource WarningBackground}"
                                    BorderBrush="{DynamicResource WarningBorder}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Visibility="Collapsed">
                                <Grid>
                                    <StackPanel Margin="0,0,190,0">
                                        <TextBlock x:Name="DiscoveryUnavailableTitle"
                                                   Text="Catálogo online opcional"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="DiscoveryUnavailableMessage"
                                                   Text="Configure IGDB ou RAWG para ver recomendações e lançamentos. Sua biblioteca e o cadastro manual continuam funcionando normalmente."
                                                   Margin="0,7,0,0"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="OpenSettings_Click"
                                            Content="Configurar APIs" />
                                </Grid>
                            </Border>

                            <StackPanel x:Name="DiscoveryContent">
                                <TextBlock Margin="0,22,6,0"
                                           HorizontalAlignment="Right"
                                           Text="As faixas carregam mais jogos perto do fim e usam cache por 12 horas"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" />

                                <ItemsControl ItemsSource="{Binding CatalogSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,24,0,0"
                                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Margin="0,0,6,11">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="20"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Margin="0,4,0,0"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="12" />
                                                </StackPanel>

                                                <Grid Margin="0,0,6,0">
                                                    <ScrollViewer x:Name="SectionScrollViewer"
                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                  VerticalScrollBarVisibility="Disabled"
                                                                  PanningMode="HorizontalOnly"
                                                                  PreviewMouseWheel="CatalogSectionScrollViewer_PreviewMouseWheel"
                                                                  ScrollChanged="CatalogSectionScrollViewer_ScrollChanged">
                                                        <ItemsControl ItemsSource="{Binding Games}"
                                                                      ItemTemplate="{StaticResource DiscoveryGameCardTemplate}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </ScrollViewer>

                                                    <Border Padding="10,6"
                                                            Margin="0,0,50,8"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Background="{DynamicResource LoadingPillBackground}"
                                                            CornerRadius="10"
                                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                                            Panel.ZIndex="3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="•••"
                                                                       Margin="0,-3,7,0"
                                                                       Foreground="{DynamicResource AccentForeground}"
                                                                       FontWeight="Bold" />
                                                            <TextBlock Text="Carregando mais"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondary}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Button Style="{StaticResource IconButton}"
                                                            Width="38"
                                                            Height="76"
                                                            Margin="4,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource FloatingButtonBackground}"
                                                            Tag="{Binding ElementName=SectionScrollViewer}"
                                                            Click="ScrollCatalogSectionLeft_Click"
                                                            Panel.ZIndex="2">
                                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                                   Text="&#xE76B;"
                                                                   FontSize="17" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}"
                                                            Width="38"
                                                            Height="76"
                                                            Margin="0,0,4,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource FloatingButtonBackground}"
                                                            Tag="{Binding ElementName=SectionScrollViewer}"
                                                            Click="ScrollCatalogSectionRight_Click"
                                                            Panel.ZIndex="2">
                                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                                   Text="&#xE76C;"
                                                                   FontSize="17" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel x:Name="DiscoveryLoadingState"
                                            Margin="0,34,0,24"
                                            Visibility="Collapsed">
                                    <ProgressBar Width="190"
                                                 Height="5"
                                                 IsIndeterminate="True" />
                                    <TextBlock Text="Carregando jogos..."
                                               Margin="0,10,0,0"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>

                                <TextBlock x:Name="CatalogAttributionText"
                                           Margin="0,14,6,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11"
                                           Cursor="Hand"
                                           TextDecorations="Underline"
                                           MouseLeftButtonDown="CatalogAttributionText_MouseLeftButtonDown" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="LibraryPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="34,28,34,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedListTitle}"
                                           FontSize="29"
                                           FontWeight="SemiBold" />
                                <Button x:Name="EditCurrentListButton"
                                        Style="{StaticResource IconButton}"
                                        Margin="8,0,0,0"
                                        Width="32"
                                        Height="32"
                                        Visibility="Collapsed"
                                        Click="EditCurrentList_Click"
                                        ToolTip="Editar esta lista">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE70F;"
                                               FontSize="14" />
                                </Button>
                                <Button x:Name="DeleteCurrentListButton"
                                        Style="{StaticResource IconButton}"
                                        Margin="2,0,0,0"
                                        Width="32"
                                        Height="32"
                                        Visibility="Collapsed"
                                        Click="DeleteCurrentList_Click"
                                        ToolTip="Excluir esta lista">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE74D;"
                                               FontSize="14"
                                               Foreground="{DynamicResource DangerForeground}" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedListSubtitle}"
                                       Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="13" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Margin="0,0,12,0"
                                    Padding="3"
                                    Background="{DynamicResource SurfaceMuted}"
                                    CornerRadius="11">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="LibraryGridViewButton"
                                            Style="{StaticResource IconButton}"
                                            Width="36"
                                            Height="36"
                                            Background="{DynamicResource Surface}"
                                            Click="ShowLibraryGridView_Click"
                                            AutomationProperties.Name="Visualização em cards"
                                            ToolTip="Visualização em cards">
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   Text="&#xF0E2;"
                                                   FontSize="15" />
                                    </Button>
                                    <Button x:Name="LibraryListViewButton"
                                            Style="{StaticResource IconButton}"
                                            Width="36"
                                            Height="36"
                                            Click="ShowLibraryListView_Click"
                                            AutomationProperties.Name="Visualização em lista"
                                            ToolTip="Visualização em lista">
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   Text="&#xEA37;"
                                                   FontSize="15" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Grid Width="290" Height="43">
                                <TextBox x:Name="OnlineSearchBox"
                                         Style="{StaticResource TextInput}"
                                         TextChanged="OnlineSearchBox_TextChanged"
                                         KeyDown="OnlineSearchBox_KeyDown" />
                                <TextBlock x:Name="OnlineSearchPlaceholder"
                                           Text="Buscar novos jogos..."
                                           Margin="14,0"
                                           Foreground="{DynamicResource SearchPlaceholderText}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <Button x:Name="LibraryAddFirstButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="9,0,0,0"
                                    Padding="16,10"
                                    Click="SearchOnline_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE710;"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Adicionar jogo" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="34,0,34,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource StatLibraryBackground}" CornerRadius="16" Padding="18,15" Margin="0,0,10,0">
                            <Grid>
                                <StackPanel Margin="0,0,44,0">
                                    <TextBlock Text="SEM NOTA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatLibraryForeground}" />
                                    <TextBlock Text="{Binding UnratedGameCount}" Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}"
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource LoadingPillBackground}"
                                        Click="ShowUnratedGames_Click"
                                        ToolTip="Ver jogos sem nota">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE8A7;"
                                               FontSize="13" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource StatRatingBackground}" CornerRadius="16" Padding="18,15" Margin="5,0">
                            <Grid>
                                <StackPanel Margin="0,0,44,0">
                                    <TextBlock Text="REVIEWS ESCRITAS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatRatingForeground}" />
                                    <TextBlock Text="{Binding ReviewedGameCount}" Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}"
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource LoadingPillBackground}"
                                        Click="ShowReviewedGames_Click"
                                        ToolTip="Ver jogos com review">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE8A7;"
                                               FontSize="13" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource StatReviewBackground}" CornerRadius="16" Padding="18,15" Margin="10,0,0,0">
                            <Grid>
                                <StackPanel Margin="0,0,44,0">
                                    <TextBlock Text="NÃO ORGANIZADOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatReviewForeground}" />
                                    <TextBlock Text="{Binding UnorganizedGameCount}" Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}"
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource LoadingPillBackground}"
                                        Click="ShowUnorganizedGames_Click"
                                        ToolTip="Ver jogos sem lista">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE8A7;"
                                               FontSize="13" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="LibraryGridView"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="28,0,20,28">
                            <ItemsControl ItemsSource="{Binding Games}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="GameCardHoverArea"
                                              Width="204"
                                              Height="322"
                                              Background="Transparent"
                                              Margin="6,0,0,0">
                                            <Button Style="{StaticResource CardButton}"
                                                    Width="184"
                                                    Height="304"
                                                    Margin="0,0,14,18"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Click="GameCard_Click"
                                                    PreviewMouseLeftButtonDown="GameCard_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="GameCard_PreviewMouseMove">
                                                <Border Background="{DynamicResource Surface}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="14">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="224" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Border Background="{DynamicResource CoverPlaceholderBackground}"
                                                                CornerRadius="13,13,0,0"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock FontFamily="Segoe Fluent Icons"
                                                                           Text="&#xE7FC;"
                                                                           FontSize="35"
                                                                           Foreground="{DynamicResource CoverPlaceholderIcon}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                <Border CornerRadius="13,13,0,0">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="{Binding CoverDisplay}"
                                                                                    Stretch="UniformToFill" />
                                                                    </Border.Background>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <Border HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,10,9,0"
                                                                Padding="8,4"
                                                                Background="{DynamicResource RatingOverlayBackground}"
                                                                CornerRadius="10">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontFamily="Segoe Fluent Icons"
                                                                           Text="&#xE735;"
                                                                           Foreground="{DynamicResource StarBrush}"
                                                                           FontSize="11"
                                                                           Margin="0,0,4,0" />
                                                                <TextBlock Text="{Binding RatingDisplay}"
                                                                           Foreground="{DynamicResource RatingOverlayForeground}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Grid.Row="1" Margin="13,10">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="14"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding YearDisplay}"
                                                                       Margin="0,5,0,0"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding CategoryDisplay}"
                                                                       Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Button>

                                            <StackPanel x:Name="GameCardActions"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,8,0,0"
                                                        Opacity="0"
                                                        IsHitTestVisible="False">
                                                <Button Style="{StaticResource IconButton}"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,0,6"
                                                        Background="{DynamicResource ActionNeutralBackground}"
                                                        ToolTip="Retirar desta lista"
                                                        Visibility="{Binding DataContext.IsViewingList, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                                        Click="RemoveGameFromCurrentList_Click">
                                                    <TextBlock Text="−"
                                                               FontSize="19"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource ActionNeutralForeground}" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        Width="32"
                                                        Height="32"
                                                        Background="{DynamicResource ActionDangerBackground}"
                                                        ToolTip="Remover da biblioteca"
                                                        Visibility="{Binding DataContext.IsViewingLibrary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                                        Click="DeleteGameFromCard_Click">
                                                    <TextBlock Text="×"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource ActionDangerForeground}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="GameCardHoverArea"
                                                     Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="GameCardActions"
                                                        Property="Opacity"
                                                        Value="1" />
                                                <Setter TargetName="GameCardActions"
                                                        Property="IsHitTestVisible"
                                                        Value="True" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ScrollViewer x:Name="LibraryListView"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Stretch"
                                      Padding="34,0,28,28"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <Border Margin="0,0,0,8"
                                        Padding="0"
                                        Background="{DynamicResource SurfaceMuted}"
                                        CornerRadius="11">
                                    <Grid Margin="12,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource CardButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,18,0"
                                                Click="SortByNameHeader_Click"
                                                ToolTip="Ordenar por nome">
                                            <TextBlock Text="Nome"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </Button>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource CardButton}"
                                                HorizontalAlignment="Left"
                                                Click="SortByReleaseHeader_Click"
                                                ToolTip="Ordenar por lançamento">
                                            <TextBlock Text="Lançamento"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </Button>
                                        <TextBlock Grid.Column="3"
                                                   Text="Nota"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Column="4"
                                                   Text="Observação"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,0,18,0" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Games}"
                                              HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Background="{DynamicResource Surface}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="13">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="70" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource CardButton}"
                                                            Height="92"
                                                            Click="GameCard_Click"
                                                            PreviewMouseLeftButtonDown="GameCard_PreviewMouseLeftButtonDown"
                                                            PreviewMouseMove="GameCard_PreviewMouseMove">
                                                        <Grid Margin="12,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="62" />
                                                                <ColumnDefinition Width="240" />
                                                                <ColumnDefinition Width="135" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Width="52"
                                                                    Height="72"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{DynamicResource CoverPlaceholderBackground}"
                                                                    CornerRadius="8"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                                                               Text="&#xE7FC;"
                                                                               FontSize="22"
                                                                               Foreground="{DynamicResource CoverPlaceholderIcon}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                    <Border CornerRadius="8">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{Binding CoverDisplay}"
                                                                                        Stretch="UniformToFill" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="1"
                                                                        Margin="0,0,18,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Margin="0,5,0,0"
                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                           FontSize="11"
                                                                           Text="{Binding CategoryDisplay}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding ReleaseDateDisplay}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <StackPanel Grid.Column="3"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock FontFamily="Segoe Fluent Icons"
                                                                           Text="&#xE735;"
                                                                           Foreground="{DynamicResource StarMutedBrush}"
                                                                           FontSize="13"
                                                                           Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding RatingDisplay}"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold" />
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="4"
                                                                       Margin="0,0,18,0"
                                                                       Text="{Binding ReviewDisplay}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Button>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconButton}"
                                                                Width="32"
                                                                Height="32"
                                                                Margin="0,0,5,0"
                                                                Background="{DynamicResource ActionNeutralBackground}"
                                                                ToolTip="Retirar desta lista"
                                                                Visibility="{Binding DataContext.IsViewingList, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                                                Click="RemoveGameFromCurrentList_Click">
                                                            <TextBlock Text="−"
                                                                       FontSize="19"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource ActionNeutralForeground}" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}"
                                                                Width="32"
                                                                Height="32"
                                                                Background="{DynamicResource ActionDangerBackground}"
                                                                ToolTip="Remover da biblioteca"
                                                                Visibility="{Binding DataContext.IsViewingLibrary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                                                Click="DeleteGameFromCard_Click">
                                                            <TextBlock Text="×"
                                                                       FontSize="20"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource ActionDangerForeground}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyLibraryState"
                                    Width="430"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Border Width="76"
                                    Height="76"
                                    Background="{DynamicResource EmptyIconBackground}"
                                    CornerRadius="22"
                                    HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE8F1;"
                                           FontSize="30"
                                           Foreground="{DynamicResource EmptyIconForeground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyLibraryTitle"
                                       Text="Sua biblioteca ainda está vazia"
                                       Margin="0,19,0,0"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="EmptyLibraryMessage"
                                       Text="Adicione jogos à biblioteca. Depois, arraste os cards entre as listas como em um kanban."
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       LineHeight="20" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Center"
                                    Click="FocusSearch_Click"
                                    Content="Adicionar primeiro jogo" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="SearchOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource OverlayScrim}"
              Visibility="Collapsed"
              Panel.ZIndex="20">
            <Border Width="760"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource AppBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid Margin="28,25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Encontrar um jogo"
                                       FontSize="26"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ProviderDescriptionText"
                                       Text="Busque online ou cadastre as informações manualmente."
                                       Margin="0,5,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="CloseSearchOverlay_Click">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE8BB;"
                                       FontSize="14" />
                        </Button>
                        <Button x:Name="OpenManualGameButton"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,48,0"
                                Padding="13,8"
                                Click="OpenManualGame_Click"
                                Content="Adicionar manualmente" />
                    </Grid>

                    <Grid x:Name="OnlineSearchPanel"
                          Grid.Row="1"
                          Margin="0,22,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Height="44">
                            <TextBox x:Name="OverlaySearchBox"
                                     Style="{StaticResource TextInput}"
                                     TextChanged="OverlaySearchBox_TextChanged"
                                     KeyDown="OverlaySearchBox_KeyDown" />
                            <TextBlock x:Name="OverlaySearchPlaceholder"
                                       Text="Nome do jogo..."
                                       Margin="14,0"
                                       Foreground="{DynamicResource SearchPlaceholderText}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0"
                                Padding="16,10"
                                Click="OverlaySearchButton_Click"
                                Content="Buscar" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,5,12"
                                                Padding="12"
                                                Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="78"
                                                        Height="105"
                                                        Background="{DynamicResource CoverPlaceholderBackground}"
                                                        CornerRadius="10"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                                   Text="&#xE7FC;"
                                                                   Foreground="{DynamicResource CoverPlaceholderIcon}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Border CornerRadius="10">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding CoverDisplay}"
                                                                            Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="7,1,16,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="15"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SourceDisplay}"
                                                               Margin="0,5,0,0"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentForeground}" />
                                                    <TextBlock Text="{Binding DescriptionDisplay}"
                                                               Margin="0,8,0,0"
                                                               MaxHeight="43"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="13,8"
                                                        VerticalAlignment="Center"
                                                        Click="AddSearchResult_Click"
                                                        Content="Adicionar" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="SearchEmptyState"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE721;"
                                       FontSize="31"
                                       Foreground="{DynamicResource EmptyGlyphForeground}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="SearchEmptyTitle"
                                       Text="Busque pelo nome de um jogo"
                                       Margin="0,13,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="SearchEmptyMessage"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="0,17,0,0"
                                    HorizontalAlignment="Center"
                                    Click="OpenManualGame_Click"
                                    Content="Cadastrar manualmente" />
                        </StackPanel>

                        <StackPanel x:Name="SearchLoadingState"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <ProgressBar Width="180" Height="5" IsIndeterminate="True" />
                            <TextBlock Text="Consultando as fontes..."
                                       Margin="0,13,0,0"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ManualGameOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource OverlayScrim}"
              Visibility="Collapsed"
              Panel.ZIndex="25">
            <Border Width="610"
                    Padding="28"
                    Background="{DynamicResource AppBackground}"
                    CornerRadius="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Cadastrar jogo manualmente"
                                           FontSize="25"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Somente o nome é obrigatório. O jogo entra direto na biblioteca."
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right"
                                    Click="CloseManualGame_Click">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE8BB;"
                                           FontSize="14" />
                            </Button>
                        </Grid>

                        <TextBlock Text="Nome *" Margin="0,22,0,6" FontSize="11" FontWeight="SemiBold" />
                        <TextBox x:Name="ManualNameBox" Style="{StaticResource TextInput}" MaxLength="160" />

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Categoria" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold" />
                                <TextBox x:Name="ManualCategoryBox" Style="{StaticResource TextInput}" MaxLength="100" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ano de lançamento" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold" />
                                <TextBox x:Name="ManualYearBox" Style="{StaticResource TextInput}" MaxLength="4" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Descrição" Margin="0,13,0,6" FontSize="11" FontWeight="SemiBold" />
                        <TextBox x:Name="ManualDescriptionBox"
                                 Style="{StaticResource TextInput}"
                                 Height="90"
                                 MaxLength="3000"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="URL da capa" Margin="0,13,0,6" FontSize="11" FontWeight="SemiBold" />
                        <TextBox x:Name="ManualCoverUrlBox" Style="{StaticResource TextInput}" MaxLength="1000" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,22,0,0"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}"
                                Margin="0,0,9,0"
                                Click="CloseManualGame_Click"
                                Content="Cancelar" />
                        <Button x:Name="SaveManualGameButton"
                                Style="{StaticResource PrimaryButton}"
                                Click="SaveManualGame_Click"
                                Content="Adicionar à biblioteca" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="CatalogDetailOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource OverlayScrim}"
              Visibility="Collapsed"
              Panel.ZIndex="27">
            <Border x:Name="CatalogDetailPanel"
                    Width="760"
                    Height="520"
                    Padding="26"
                    Background="{DynamicResource AppBackground}"
                    CornerRadius="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="205"
                            Height="300"
                            VerticalAlignment="Top"
                            Background="{DynamicResource CoverPlaceholderBackground}"
                            CornerRadius="15"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE7FC;"
                                       FontSize="36"
                                       Foreground="{DynamicResource CoverPlaceholderIcon}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Border CornerRadius="15">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CoverDisplay}"
                                                Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Grid>
                                <StackPanel Margin="0,0,44,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SourceDisplay}"
                                               Margin="0,6,0,0"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentForeground}" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="CloseCatalogDetail_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="14" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding YearDisplay}"
                                       Margin="0,17,0,0"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding CategoryDisplay}"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="SOBRE"
                                       Margin="0,24,0,7"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <ScrollViewer Height="205" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding DescriptionDisplay}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           LineHeight="20" />
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,9,0"
                                    Click="CloseCatalogDetail_Click"
                                    Content="Fechar" />
                            <Button x:Name="AddCatalogGameButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="AddCatalogGame_Click"
                                    Content="Adicionar à biblioteca" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="DetailOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource OverlayScrim}"
              Visibility="Collapsed"
              Panel.ZIndex="30">
            <Border x:Name="DetailPanel"
                    Width="850"
                    Height="610"
                    Padding="26"
                    Background="{DynamicResource AppBackground}"
                    CornerRadius="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="225" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="205"
                                Height="285"
                                VerticalAlignment="Top"
                                Background="{DynamicResource CoverPlaceholderBackground}"
                                CornerRadius="15"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE7FC;"
                                           FontSize="36"
                                           Foreground="{DynamicResource CoverPlaceholderIcon}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Border CornerRadius="15">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CoverDisplay}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Grid>
                                <StackPanel Margin="0,0,48,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="25"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding YearDisplay}"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding CategoryDisplay}"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="CloseDetailOverlay_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="14" />
                                </Button>
                            </Grid>

                            <TextBlock Text="SOBRE" Margin="0,20,0,7" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding Description}"
                                       Height="66"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondary}"
                                       LineHeight="19" />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SUA NOTA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Slider x:Name="RatingSlider"
                                                Width="155"
                                                Minimum="0"
                                                Maximum="10"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="RatingSlider_ValueChanged" />
                                        <Border Margin="10,0,0,0" Width="43" Height="30" Background="{DynamicResource RatingValueBackground}" CornerRadius="10">
                                            <TextBlock x:Name="RatingValueText"
                                                       Text="0.0"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="NoRatingCheckBox"
                                              Content="Ainda sem nota"
                                              Margin="0,8,0,0"
                                              Checked="NoRatingCheckBox_Changed"
                                              Unchecked="NoRatingCheckBox_Changed" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="LISTAS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                    <ItemsControl ItemsSource="{Binding MembershipOptions}" Margin="0,7,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,13,7">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Emoji}"
                                                                   Style="{StaticResource EmojiText}"
                                                                   Width="22"
                                                                   Height="18"
                                                                   FontSize="12"
                                                                   LineHeight="17"
                                                                   Margin="0,0,5,0" />
                                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Color}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="SUA REVIEW" Margin="0,18,0,7" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                            <TextBox x:Name="ReviewTextBox"
                                     Style="{StaticResource TextInput}"
                                     Height="105"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Button Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Left"
                                Click="DeleteGame_Click"
                                Content="Remover da biblioteca" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,9,0"
                                    Click="CloseDetailOverlay_Click"
                                    Content="Cancelar" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Click="SaveGameDetails_Click"
                                    Content="Salvar alterações" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource OverlayScrim}"
              Visibility="Collapsed"
              Panel.ZIndex="40">
            <Border Width="660"
                    Padding="28"
                    Background="{DynamicResource AppBackground}"
                    CornerRadius="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Configurações"
                                           FontSize="25"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Ajuste a aparência e as fontes online. As credenciais ficam protegidas pelo Windows."
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right"
                                    Click="CloseSettings_Click">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="14" />
                            </Button>
                        </Grid>

                        <Border Margin="0,23,0,0"
                                Padding="18"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="15">
                            <Grid>
                                <StackPanel Margin="0,0,170,0">
                                    <TextBlock Text="Aparência"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Alterne entre o tema claro e escuro."
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="ToggleTheme_Click"
                                        Content="{Binding ThemeToggleText}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource StatLibraryBackground}" CornerRadius="15">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="IGDB" FontSize="16" FontWeight="SemiBold" />
                                    <Button HorizontalAlignment="Right"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource LinkAccent}"
                                            Cursor="Hand"
                                            Click="OpenIgdbDocs_Click"
                                            Content="Como obter credenciais ↗" />
                                </Grid>
                                <TextBlock Text="Client ID" Margin="0,14,0,6" FontSize="11" FontWeight="SemiBold" />
                                <PasswordBox x:Name="IgdbClientIdBox" Style="{StaticResource PasswordInput}" />
                                <TextBlock Text="Client Secret" Margin="0,12,0,6" FontSize="11" FontWeight="SemiBold" />
                                <PasswordBox x:Name="IgdbClientSecretBox" Style="{StaticResource PasswordInput}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource StatRatingBackground}" CornerRadius="15">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="RAWG" FontSize="16" FontWeight="SemiBold" />
                                    <Button HorizontalAlignment="Right"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource StatRatingForeground}"
                                            Cursor="Hand"
                                            Click="OpenRawgDocs_Click"
                                            Content="Obter uma chave ↗" />
                                </Grid>
                                <TextBlock Text="API Key" Margin="0,14,0,6" FontSize="11" FontWeight="SemiBold" />
                                <PasswordBox x:Name="RawgApiKeyBox" Style="{StaticResource PasswordInput}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Button Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Click="OpenDataFolder_Click"
                                Content="Abrir pasta dos dados" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,9,0"
                                    Click="CloseSettings_Click"
                                    Content="Cancelar" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Click="SaveSettings_Click"
                                    Content="Salvar configurações" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ListEditorOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource OverlayScrim}"
              Visibility="Collapsed"
              Panel.ZIndex="50">
            <Border Width="470"
                    Padding="27"
                    Background="{DynamicResource AppBackground}"
                    CornerRadius="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ListEditorTitle"
                               Text="Criar uma lista"
                               FontSize="23"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ListEditorSubtitle"
                               Text="Personalize o nome, o emoji e a cor da lista."
                               Margin="0,6,0,18"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Emoji" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold" />
                            <ComboBox x:Name="ListEmojiComboBox"
                                      ItemsSource="{Binding ListEmojiOptions}"
                                      SelectedValue="{Binding SelectedListEmoji, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Emoji"
                                      Height="42"
                                      Width="86"
                                      HorizontalAlignment="Left"
                                      Padding="8,4"
                                      Background="{DynamicResource Surface}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      Foreground="{DynamicResource TextPrimary}">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Width="168" />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Emoji}"
                                                   Style="{StaticResource EmojiText}"
                                                   FontSize="19"
                                                   Width="34"
                                                   Height="30"
                                                   LineHeight="28"
                                                   ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Nome" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold" />
                            <TextBox x:Name="NewListNameBox"
                                     Style="{StaticResource TextInput}"
                                     MaxLength="40"
                                     KeyDown="NewListNameBox_KeyDown" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Cor da lista"
                               Margin="0,17,0,8"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#CFC4F5" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#CFC4F5" />
                        </Button>
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#B9DDCF" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#B9DDCF" />
                        </Button>
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#F5C6B5" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#F5C6B5" />
                        </Button>
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#EEDDA8" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#EEDDA8" />
                        </Button>
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#BFD6ED" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#BFD6ED" />
                        </Button>
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#E6C4D8" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#E6C4D8" />
                        </Button>
                        <Border x:Name="SelectedListColorPreview"
                                Width="30"
                                Height="30"
                                Margin="2,0,0,0"
                                CornerRadius="15"
                                BorderBrush="{DynamicResource SelectedSwatchBorder}"
                                BorderThickness="2"
                                Background="#CFC4F5" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,22,0,0"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}"
                                Margin="0,0,9,0"
                                Click="CloseListEditor_Click"
                                Content="Cancelar" />
                        <Button x:Name="SaveListButton"
                                Style="{StaticResource PrimaryButton}"
                                Click="SaveList_Click"
                                Content="Criar lista" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="Toast"
                Grid.RowSpan="2"
                Margin="0,0,28,26"
                Padding="15,11"
                Background="{DynamicResource ToastBackground}"
                CornerRadius="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <TextBlock x:Name="ToastText"
                       Foreground="White"
                       FontSize="13" />
        </Border>
    </Grid>
</Window>
