                            <Ellipse Width="30" Height="30" Fill="#F5C6B5" />
                        </Button>
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#EEDDA8" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#EEDDA8" />
                        </Button>
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#BFD6ED" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#BFD6ED" />
                        </Button>
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#E6C4D8" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#E6C4D8" />
                        </Button>
                        <Border x:Name="SelectedListColorPreview"
                                Width="30"
                                Height="30"
                                Margin="2,0,0,0"
                                CornerRadius="15"
                                BorderBrush="#29282D"
                                BorderThickness="2"
                                Background="#CFC4F5" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,22,0,0"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}"
                                Margin="0,0,9,0"
                                Click="CloseListEditor_Click"
                                Content="Cancelar" />
                        <Button x:Name="SaveListButton"
                                Style="{StaticResource PrimaryButton}"
                                Click="SaveList_Click"
                                Content="Criar lista" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="Toast"
                Grid.RowSpan="2"
                Margin="0,0,28,26"
                Padding="15,11"
                Background="#F329282D"
                CornerRadius="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <TextBlock x:Name="ToastText"
                       Foreground="White"
                       FontSize="13" />
        </Border>
    </Grid>
</Window>
