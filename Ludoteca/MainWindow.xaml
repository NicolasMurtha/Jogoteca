                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE7FC;"
                                           FontSize="36"
                                           Foreground="{DynamicResource CoverPlaceholderIcon}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Border CornerRadius="15">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CoverDisplay, Converter={StaticResource CoverImage}, ConverterParameter=205x285}"
