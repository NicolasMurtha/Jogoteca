                            <Ellipse Width="30" Height="30" Fill="#BFD6ED" />
                        </Button>
                        <Button x:Name="ListColorPinkButton" Style="{StaticResource ColorSwatchButton}" Tag="#E6C4D8" Click="ListColor_Click">
                            <Ellipse Width="30" Height="30" Fill="#E6C4D8" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,22,0,0"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}"
                                Margin="0,0,9,0"
                                Click="CloseListEditor_Click"
