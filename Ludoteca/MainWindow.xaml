        <Grid x:Name="DetailOverlay"
              Grid.RowSpan="2"
              Background="#7629282D"
              Visibility="Collapsed"
              Panel.ZIndex="30">
            <Border x:Name="DetailPanel"
                    Width="850"
                    Height="610"
                    Padding="26"
                    Background="{StaticResource AppBackground}"
                    CornerRadius="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="225" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="205"
                                Height="285"
                                VerticalAlignment="Top"
                                Background="#DDD9D3"
                                CornerRadius="15"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE7FC;"
                                           FontSize="36"
                                           Foreground="#AAA6A0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Border CornerRadius="15">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CoverDisplay}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Grid>
                                <StackPanel Margin="0,0,48,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="25"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding YearDisplay}"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding CategoryDisplay}"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="CloseDetailOverlay_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="14" />
                                </Button>
                            </Grid>

                            <TextBlock Text="SOBRE" Margin="0,20,0,7" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding Description}"
                                       Height="66"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextSecondary}"
                                       LineHeight="19" />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SUA NOTA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Slider x:Name="RatingSlider"
                                                Width="155"
                                                Minimum="0"
                                                Maximum="10"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="RatingSlider_ValueChanged" />
                                        <Border Margin="10,0,0,0" Width="43" Height="30" Background="#E7E1F7" CornerRadius="10">
                                            <TextBlock x:Name="RatingValueText"
                                                       Text="0.0"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="NoRatingCheckBox"
                                              Content="Ainda sem nota"
                                              Margin="0,8,0,0"
                                              Checked="NoRatingCheckBox_Changed"
                                              Unchecked="NoRatingCheckBox_Changed" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="LISTAS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                    <ItemsControl ItemsSource="{Binding MembershipOptions}" Margin="0,7,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,13,7">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Emoji}" Margin="0,0,5,0" FontSize="12" />
                                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Color}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="SUA REVIEW" Margin="0,18,0,7" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                            <TextBox x:Name="ReviewTextBox"
                                     Style="{StaticResource TextInput}"
                                     Height="105"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Button Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Left"
                                Click="DeleteGame_Click"
                                Content="Remover da biblioteca" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,9,0"
                                    Click="CloseDetailOverlay_Click"
                                    Content="Cancelar" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Click="SaveGameDetails_Click"
                                    Content="Salvar alterações" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

