                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="13,8"
                                                        VerticalAlignment="Center"
                                                        Click="AddSearchResult_Click"
                                                        Content="Adicionar" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="SearchEmptyState"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE721;"
                                       FontSize="31"
                                       Foreground="#A09BA5"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="SearchEmptyTitle"
                                       Text="Busque pelo nome de um jogo"
                                       Margin="0,13,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
