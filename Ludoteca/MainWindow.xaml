                                    </Grid>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Margin="0,14,0,0"
                                            HorizontalAlignment="Left"
                                            Click="OpenRawgDocs_Click"
                                            Content="Abrir o RAWG ↗" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="IgdbGuideSection"
                                    Margin="0,12,0,0"
                                    Padding="18"
                                    Background="{DynamicResource StatLibraryBackground}"
                                    CornerRadius="15">
                                <StackPanel>
                                    <TextBlock Text="IGDB · opcional, dados mais completos"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Usa uma conta da Twitch. Com as duas fontes configuradas, a JOGOTECA usa o IGDB primeiro e o RAWG como reserva."
                                               Margin="0,4,0,4"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="1." FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Entre na sua conta da Twitch (ou crie uma) e ative a verificação em duas etapas, em Configurações → Segurança e privacidade." TextWrapping="Wrap" LineHeight="20" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="2." FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Clique em Abrir o console da Twitch abaixo e escolha Registrar seu aplicativo (Register Your Application)." TextWrapping="Wrap" LineHeight="20" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="3." FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Nome: algo único, como JOGOTECA-seunome. URL de redirecionamento OAuth: http://localhost. Categoria: Application Integration. Tipo de cliente: Confidencial (Confidential)." TextWrapping="Wrap" LineHeight="20" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="4." FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Clique em Criar e depois em Gerenciar (Manage) no aplicativo criado." TextWrapping="Wrap" LineHeight="20" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="5." FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Copie o ID do cliente (Client ID). Depois clique em Novo segredo (New Secret) e copie o segredo: ele só aparece uma vez." TextWrapping="Wrap" LineHeight="20" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="6." FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Cole os dois nos campos do IGDB, em Configurações." TextWrapping="Wrap" LineHeight="20" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,9,0"
                                                Click="OpenTwitchConsole_Click"
                                                Content="Abrir o console da Twitch ↗" />
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource LinkAccent}"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Click="OpenIgdbDocs_Click"
                                                Content="Instruções oficiais (inglês) ↗" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Style="{StaticResource SecondaryButton}"
                                Margin="0,0,9,0"
                                Click="CloseApiGuide_Click"
                                Content="Fechar" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Click="ApiGuideOpenSettings_Click"
                                Content="Já tenho a chave" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

