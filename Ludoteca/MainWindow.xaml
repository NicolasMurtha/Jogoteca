                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="45,0,0,0"
                                                       HorizontalAlignment="Left" />
                                            <TextBlock Text="10"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="LISTAS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
