                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <StackPanel Margin="0,7,0,0"
                                                HorizontalAlignment="Center">
                                        <Border Width="82"
                                                Height="30"
                                                Margin="0,0,0,6"
