                                                               FontSize="15"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SourceDisplay}"
                                                               Margin="0,5,0,0"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="#66568E" />
                                                    <TextBlock Text="{Binding DescriptionDisplay}"
                                                               Margin="0,8,0,0"
