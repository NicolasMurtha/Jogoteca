                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,9,7"
                                                        Padding="9,6"
                                                        Background="{DynamicResource SurfaceMuted}"
                                                        CornerRadius="11">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Emoji}"
                                                                   Style="{StaticResource EmojiText}"
                                                                   Width="22"
                                                                   Height="18"
                                                                   FontSize="12"
                                                                   LineHeight="17"
                                                                   Margin="0,0,5,0" />
                                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Color}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="INÍCIO"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <DatePicker x:Name="StartedAtPicker"
                                                Style="{StaticResource ThemedDatePicker}"
                                                Margin="0,7,0,0"
                                                SelectedDateFormat="Short" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0">
                                    <TextBlock Text="FINALIZAÇÃO"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <DatePicker x:Name="FinishedAtPicker"
                                                Style="{StaticResource ThemedDatePicker}"
                                                Margin="0,7,0,0"
                                                SelectedDateFormat="Short" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="SUA REVIEW" Margin="0,18,0,7" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                            <TextBox x:Name="ReviewTextBox"
                                     Style="{StaticResource TextInput}"
                                     Height="92"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Button Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Left"
                                Click="DeleteGame_Click"
                                Content="Remover da biblioteca" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,9,0"
                                    Click="CloseDetailOverlay_Click"
                                    Content="Cancelar" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Click="SaveGameDetails_Click"
                                    Content="Salvar alterações" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

