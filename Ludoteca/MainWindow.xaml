<Window x:Class="Ludoteca.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="JOGOTECA"
        Width="1380"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,9,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F7F6F4"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            Margin="15,0"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/LudotecaMark.png"
                           Width="24"
                           Height="24"
                           Stretch="UniformToFill" />
                    <TextBlock Text="JOGOTECA"
                               Margin="9,0,0,0"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <Border Margin="9,0,0,0"
                            Padding="7,2"
                            Background="#E7E1F7"
                            CornerRadius="8">
                        <TextBlock Text="1.2"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#66568E" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="&#xE921;"
                                   FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="MaximizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeIcon"
                                   FontFamily="Segoe Fluent Icons"
                                   Text="&#xE922;"
                                   FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="46"
                            Height="43"
                            Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="&#xE8BB;"
                                   FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="15,18,15,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="6,2,6,18">
                        <TextBlock Text="MEU BACKLOG"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="Descubra, guarde e organize"
                                   Margin="0,7,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="os jogos do seu jeito."
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="DiscoverButton"
                                Style="{StaticResource NavButton}"
                                Background="#D7D2E8"
                                Click="DiscoverButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE8B1;"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Descobrir"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="AllGamesButton"
                                Style="{StaticResource NavButton}"
                                Margin="0,3,0,0"
                                Click="AllGamesButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE8F1;"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Biblioteca"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Background="#C4B8E9"
                                        Padding="7,2"
                                        CornerRadius="9">
                                    <TextBlock Text="{Binding TotalGameCount}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,22,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="7,0,5,9">
                            <TextBlock Text="LISTAS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="OpenCreateListButton"
                                    Style="{StaticResource IconButton}"
                                    Width="27"
                                    Height="27"
                                    HorizontalAlignment="Right"
                                    Click="OpenCreateList_Click"
                                    ToolTip="Criar lista">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE710;"
                                           FontSize="12" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Lists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavButton}"
                                                Margin="0,2"
                                                AllowDrop="True"
                                                Click="ListButton_Click"
                                                DragEnter="ListButton_DragEnter"
                                                DragLeave="ListButton_DragLeave"
                                                Drop="ListButton_Drop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="20"
                                                      HorizontalAlignment="Left">
                                                    <Ellipse Width="14"
                                                             Height="14"
                                                             Fill="{Binding Color}" />
                                                    <TextBlock Text="{Binding Emoji}"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CountDisplay}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Button Grid.Row="3"
                            Style="{StaticResource NavButton}"
                            Click="OpenSettings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE713;"
                                       FontSize="16" />
                            <TextBlock Grid.Column="1"
                                       Text="Configurações"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="DiscoveryPanel">
                    <ScrollViewer x:Name="DiscoveryScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="DiscoveryScrollViewer_ScrollChanged">
                        <StackPanel Margin="34,28,28,36">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Descobrir"
                                               FontSize="30"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Um catálogo para encontrar o próximo jogo da sua biblioteca."
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="13" />
                                </StackPanel>
                                <Button Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="SearchOnline_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   Text="&#xE721;"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="Buscar jogo" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border x:Name="DiscoveryUnavailableState"
                                    Margin="0,26,6,0"
                                    Padding="28"
                                    Background="#FFF3D7"
                                    BorderBrush="#E9D18F"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Visibility="Collapsed">
                                <Grid>
                                    <StackPanel Margin="0,0,190,0">
                                        <TextBlock Text="Catálogo online opcional"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Configure IGDB ou RAWG para ver recomendações e lançamentos. Sua biblioteca e o cadastro manual continuam funcionando normalmente."
                                                   Margin="0,7,0,0"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="OpenSettings_Click"
                                            Content="Configurar APIs" />
                                </Grid>
                            </Border>

                            <StackPanel x:Name="DiscoveryContent">
                                <Grid Margin="0,30,6,14">
                                    <StackPanel>
                                        <TextBlock Text="Recomendados para você"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Jogos bem avaliados para explorar e adicionar à biblioteca."
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Text="Clique em um jogo para ver os detalhes"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11" />
                                </Grid>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Margin="0,0,6,0">
                                    <ItemsControl ItemsSource="{Binding RecommendedGames}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CardButton}"
                                                        Width="176"
                                                        Height="286"
                                                        Margin="0,0,14,10"
                                                        Click="CatalogCard_Click">
                                                    <Border Background="{StaticResource Surface}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="14">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="210" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Border Background="#DDD9D3"
                                                                    CornerRadius="13,13,0,0"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                                                               Text="&#xE7FC;"
                                                                               FontSize="34"
                                                                               Foreground="#AAA6A0"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                    <Border CornerRadius="13,13,0,0">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{Binding CoverDisplay}"
                                                                                        Stretch="UniformToFill" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Row="1" Margin="12,10">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding YearDisplay}"
                                                                           Margin="0,5,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextSecondary}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel Margin="0,30,0,0">
                                    <TextBlock Text="Últimos lançamentos"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Continue rolando para carregar mais jogos."
                                               Margin="0,4,0,14"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding LatestGames}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource CardButton}"
                                                    Width="176"
                                                    Height="286"
                                                    Margin="0,0,14,18"
                                                    Click="CatalogCard_Click">
                                                <Border Background="{StaticResource Surface}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="14">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="210" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Border Background="#DDD9D3"
                                                                CornerRadius="13,13,0,0"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock FontFamily="Segoe Fluent Icons"
                                                                           Text="&#xE7FC;"
                                                                           FontSize="34"
                                                                           Foreground="#AAA6A0"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                <Border CornerRadius="13,13,0,0">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="{Binding CoverDisplay}"
                                                                                    Stretch="UniformToFill" />
                                                                    </Border.Background>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Row="1" Margin="12,10">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding YearDisplay}"
                                                                       Margin="0,5,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextSecondary}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel x:Name="DiscoveryLoadingState"
                                            Margin="0,8,0,12"
                                            Visibility="Collapsed">
                                    <ProgressBar Width="190"
                                                 Height="5"
                                                 IsIndeterminate="True" />
                                    <TextBlock Text="Carregando jogos..."
                                               Margin="0,10,0,0"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>

                                <TextBlock x:Name="CatalogAttributionText"
                                           Margin="0,14,6,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           Cursor="Hand"
                                           TextDecorations="Underline"
                                           MouseLeftButtonDown="CatalogAttributionText_MouseLeftButtonDown" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="LibraryPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="34,28,34,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedListTitle}"
                                           FontSize="29"
                                           FontWeight="SemiBold" />
                                <Button x:Name="EditCurrentListButton"
                                        Style="{StaticResource IconButton}"
                                        Margin="8,0,0,0"
                                        Width="32"
                                        Height="32"
                                        Visibility="Collapsed"
                                        Click="EditCurrentList_Click"
                                        ToolTip="Editar esta lista">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE70F;"
                                               FontSize="14" />
                                </Button>
                                <Button x:Name="DeleteCurrentListButton"
                                        Style="{StaticResource IconButton}"
                                        Margin="2,0,0,0"
                                        Width="32"
                                        Height="32"
                                        Visibility="Collapsed"
                                        Click="DeleteCurrentList_Click"
                                        ToolTip="Excluir esta lista">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE74D;"
                                               FontSize="14"
                                               Foreground="#9A5555" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedListSubtitle}"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="13" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Grid Width="290" Height="43">
                                <TextBox x:Name="OnlineSearchBox"
                                         Style="{StaticResource TextInput}"
                                         TextChanged="OnlineSearchBox_TextChanged"
                                         KeyDown="OnlineSearchBox_KeyDown" />
                                <TextBlock x:Name="OnlineSearchPlaceholder"
                                           Text="Buscar novos jogos..."
                                           Margin="14,0"
                                           Foreground="#9A969E"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <Button x:Name="LibraryAddFirstButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="9,0,0,0"
                                    Padding="16,10"
                                    Click="SearchOnline_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE710;"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Adicionar jogo" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="34,0,34,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#E7E1F7" CornerRadius="16" Padding="18,15" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="NA BIBLIOTECA" FontSize="10" FontWeight="Bold" Foreground="#746991" />
                                <TextBlock Text="{Binding TotalGameCount}" Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#DDEEE7" CornerRadius="16" Padding="18,15" Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="MÉDIA DAS NOTAS" FontSize="10" FontWeight="Bold" Foreground="#56796D" />
                                <TextBlock Text="{Binding AverageRating}" Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#F6E2DA" CornerRadius="16" Padding="18,15" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="REVIEWS ESCRITAS" FontSize="10" FontWeight="Bold" Foreground="#956E5E" />
                                <TextBlock Text="{Binding ReviewedGameCount}" Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="28,0,20,28">
                            <ItemsControl ItemsSource="{Binding Games}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CardButton}"
                                                Width="184"
                                                Height="304"
                                                Margin="6,0,10,18"
                                                Click="GameCard_Click"
                                                PreviewMouseLeftButtonDown="GameCard_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="GameCard_PreviewMouseMove">
                                            <Border Background="{StaticResource Surface}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="224" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="#DDD9D3"
                                                            CornerRadius="13,13,0,0"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock FontFamily="Segoe Fluent Icons"
                                                                       Text="&#xE7FC;"
                                                                       FontSize="35"
                                                                       Foreground="#AAA6A0"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Border CornerRadius="13,13,0,0">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding CoverDisplay}"
                                                                                Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,10,9,0"
                                                            Padding="8,4"
                                                            Background="#EE29282D"
                                                            CornerRadius="10">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="Segoe Fluent Icons"
                                                                       Text="&#xE735;"
                                                                       Foreground="#F0D791"
                                                                       FontSize="11"
                                                                       Margin="0,0,4,0" />
                                                            <TextBlock Text="{Binding RatingDisplay}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Grid.Row="1" Margin="13,10">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding YearDisplay}"
                                                                   Margin="0,5,0,0"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CategoryDisplay}"
                                                                   Margin="0,2,0,0"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

